{
  "name": "@ilbertt/apigen",
  "description": "WinterTC-compatible REST API handlers from your Postgres schema",
  "version": "0.0.0",
  "author": "ilbertt",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilbertt/apigen",
    "directory": "packages/apigen"
  },
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=18",
    "bun": "^1.3.0"
  },
  "bin": {
    "apigen": "./dist/codegen/cli/main.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.4"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "dependencies": {}
}
