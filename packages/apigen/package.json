{
  "name": "@repo/apigen",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:lib": "bun run --bun tsc -p tsconfig.build.json",
